{
  "name": "toybox-mayhem",
  "version": "1.0.0",
  "description": "TOYBOX MAYHEM - a 3D toy arena shooter (Three.js + Rapier + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:standalone": "tsc && vite build --mode standalone && node -e \"const f=require('fs');f.renameSync('standalone/index.html','standalone/ToyboxMayhem.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc",
    "server": "node server/index.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "@fontsource/baloo-2": "5.1.0",
    "@fontsource/luckiest-guy": "5.1.0",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3",
    "ws": "^8.18.0"
  },
  "private": true,
  "type": "module"
}
